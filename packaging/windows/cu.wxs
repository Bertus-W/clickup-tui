<!--
  The Windows installer (WiX 5): cu.exe in %LocalAppData%\Programs\cu, on the user's PATH.
  Per user, so it needs no administrator rights; uninstall from Settings → Apps.

    wix build packaging\windows\cu.wxs -arch x64 -d Version=0.1.0 -d Exe=path\to\cu.exe -o cu.msi

  The UpgradeCode never changes: it's how a newer cu.msi finds and replaces an older one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="cu (ClickUp terminal UI)" Manufacturer="Bertus" Version="$(var.Version)"
           UpgradeCode="069E29A6-C161-411B-B995-DF025870A7D1" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of cu is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPURLINFOABOUT" Value="https://codeberg.org/b-wisman/clickup-tui" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="cu" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main">
      <!-- Files in the user profile need a registry value as their key path. -->
      <Component Directory="INSTALLFOLDER">
        <File Source="$(var.Exe)" Name="cu.exe" />
        <RegistryValue Root="HKCU" Key="Software\clickup-tui" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" Permanent="no" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      </Component>
    </Feature>
  </Package>
</Wix>
